# =============================================================================
# Variables de entorno del microservicio de trazabilidad (plazoleta-trazabilidad)
# Copia este archivo como .env en la raíz del proyecto:  Copy-Item .env.example .env
# El archivo .env no se sube a git.
# =============================================================================

# --- Seguridad compartida con los demás microservicios (deben ser IGUALES en todos) ---
# Clave HS256 para validar el JWT que emite el servicio de usuarios (mínimo 32 caracteres)
APP_JWT_SECRET=cambia-esta-clave-por-una-de-al-menos-32-caracteres
# Token para las rutas /internal/** entre microservicios
USERS_INTERNAL_TOKEN=cambia-este-token-interno

# --- MongoDB (instalado en el PC como servicio de Windows, puerto 27017) ---
MONGODB_URI=mongodb://localhost:27017/plazoleta_trazabilidad
